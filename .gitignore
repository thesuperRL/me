# Personal content -- keep local or on your fork, not on the shared main repo.
# Config stubs (General.md, Personal.md, Writing_Preferences.md, etc.) are tracked
# as templates; fill them in on your fork.

# Events (personal notes -- accumulate per-event files here)
Events/[0-9]*.md

# Experiences (role-linked personal notes)
Experiences/*.md
!Experiences/.gitkeep

# Written essays and drafts
Writtens/*.md
Writtens/**/*.md
!Writtens/.gitkeep
!Writtens/Generated/.gitkeep
!Writtens/Old College Apps/.gitkeep

# Generated resumes
Resumes/Generated/*.tex
Resumes/Generated/*.pdf
!Resumes/Generated/.gitkeep
Resumes/images/
Resumes/*.pdf

# Applications and job links (personal cycle tracking)
Applications/*.md
!Applications/.gitkeep
Job Links/*.md
!Job Links/.gitkeep

# Academics large files
Academics/all-schedules.txt

# Repo Indexing personal project files (not the README)
Repo Indexing/*.md
!Repo Indexing/README.md
